# Copy to .env.local and fill in from Supabase dashboard > Project Settings > API Keys.
# Only the publishable key goes here; never put the secret/service key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
